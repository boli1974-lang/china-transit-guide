---
import { getData } from 'country-list';
import {
  chinaTransitEligibleCountries,
  chinaTransitPorts,
  chinaTransitPermittedAreas,
} from '../data/china-transit-policy';

const sortedCountries = [...chinaTransitEligibleCountries].sort((a, b) =>
  a.localeCompare(b)
);

const sortedPorts = [...chinaTransitPorts].sort((a, b) =>
  a.portName.localeCompare(b.portName)
);

const sortedPermittedAreas = [...chinaTransitPermittedAreas].sort((a, b) =>
  a.region.localeCompare(b.region)
);

const routePlaceDisplayNames: Record<string, string> = {
  CN: 'Mainland China',
  HK: 'Hong Kong',
  MO: 'Macao',
  TW: 'Taiwan',
  KR: 'South Korea',
  KP: 'North Korea',
};

const routePlaces = getData()
  .map((place) => ({
    code: place.code,
    name: routePlaceDisplayNames[place.code] ?? place.name,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<section class="checker" id="itinerary-checker">
  <div class="checker-header">
    <p class="eyebrow">Interactive eligibility checker</p>
    <h2>Check Your 240-Hour Transit Itinerary</h2>
    <p>
      Answer a few questions to see whether your trip appears to meet the
      core published requirements for China's 240-hour visa-free transit policy.
    </p>
    <p class="checker-disclaimer">
      This tool provides general information only. It does not guarantee airline
      boarding or admission into China. Chinese immigration authorities make the
      final decision.
    </p>
  </div>

  <form id="transit-checker-form" novalidate>
    <div class="progress" aria-label="Checker progress">
      <span class="progress-step is-active" data-progress-step="1">1</span>
      <span class="progress-line"></span>
      <span class="progress-step" data-progress-step="2">2</span>
      <span class="progress-line"></span>
      <span class="progress-step" data-progress-step="3">3</span>
      <span class="progress-line"></span>
      <span class="progress-step" data-progress-step="4">4</span>
    </div>

    <section class="checker-step" data-step="1">
      <p class="step-label">Step 1 of 4</p>
      <h3>Your passport</h3>

      <label>
        Passport nationality
        <select id="nationality" name="nationality" required>
          <option value="">Select your nationality</option>
          {
            sortedCountries.map((country) => (
              <option value={country}>{country}</option>
            ))
          }
          <option value="__other__">Other nationality — not on current 240-hour list</option>
        </select>
      </label>

      <p class="helper-text">
        This list contains the nationalities currently eligible for the
        240-hour visa-free transit policy. If you cannot find your nationality,
        select “Other nationality — not on current 240-hour list.”
      </p>

      <label>
        Passport expiration date
        <input
          id="passport-expiration"
          name="passportExpirationDate"
          type="date"
          required
        />
      </label>

      <div class="us-passport-note" id="us-passport-note" hidden>
        <strong>U.S. passport holder?</strong>
        Current U.S. travel guidance recommends at least six months of validity
        beyond arrival and at least two blank passport pages.
      </div>

      <div class="step-actions">
        <button type="button" class="primary-button" data-next-step>
          Continue
        </button>
      </div>
    </section>

    <section class="checker-step" data-step="2" hidden>
      <p class="step-label">Step 2 of 4</p>
      <h3>Your international route</h3>

      <p class="helper-text">
        Enter the country or region immediately before Mainland China and the
        country or region immediately after Mainland China. International
        layovers matter.
      </p>

      <div class="route-display" aria-hidden="true">
        <span>Country / Region A</span>
        <strong>→ Mainland China →</strong>
        <span>Country / Region B</span>
      </div>

      <label>
        Immediately before Mainland China
        <input
          id="previous-country"
          name="previousCountryOrRegion"
          type="text"
          list="route-places"
          autocomplete="off"
          placeholder="Example: Japan"
          data-route-place
          required
        />
      </label>

      <label id="previous-country-other-wrap" hidden>
        Enter the country or region name
        <input
          id="previous-country-other"
          name="previousCountryOrRegionOther"
          type="text"
          autocomplete="off"
          placeholder="Enter the actual country or region"
          minlength="2"
        />
        <span class="helper-text">
          Enter at least 2 characters and include the actual country or region name.
        </span>
      </label>

      <label>
        Immediately after Mainland China
        <input
          id="next-country"
          name="nextCountryOrRegion"
          type="text"
          list="route-places"
          autocomplete="off"
          placeholder="Example: South Korea"
          data-route-place
          required
        />
      </label>

      <label id="next-country-other-wrap" hidden>
        Enter the country or region name
        <input
          id="next-country-other"
          name="nextCountryOrRegionOther"
          type="text"
          autocomplete="off"
          placeholder="Enter the actual country or region"
          minlength="2"
        />
        <span class="helper-text">
          Enter at least 2 characters and include the actual country or region name.
        </span>
      </label>

      <p class="helper-text">
        <strong>Important:</strong> You must already have confirmed onward
        transportation from Mainland China to this country or region, with a
        confirmed departure date and seat or booking. Without confirmed onward
        transportation, you cannot rely on the 240-hour visa-free transit policy.
      </p>

      <p class="helper-text">
        Start typing and select a country or region from the standardized list.
        If your location is not listed, choose “Other / not listed.”
      </p>

      <datalist id="route-places">
        {routePlaces.map((place) => <option value={place.name} />)}
        <option value="Other / not listed" />
      </datalist>

      <p class="helper-text">
        Hong Kong, Macao and Taiwan are listed separately from Mainland China
        because they count as separate countries or regions for this transit-route test.
      </p>

      <div class="step-actions">
        <button type="button" class="secondary-button" data-previous-step>
          Back
        </button>
        <button type="button" class="primary-button" data-next-step>
          Continue
        </button>
      </div>
    </section>

    <section class="checker-step" data-step="3" hidden>
      <p class="step-label">Step 3 of 4</p>
      <h3>Your China entry and departure</h3>

      <label>
        Entry port
        <select id="entry-port" name="entryPort" required>
          <option value="">Select an entry port</option>
          {
            sortedPorts.map((port) => (
              <option value={port.portName}>
                {port.portName} — {port.region}
              </option>
            ))
          }
        </select>
      </label>

      <label>
        Arrival date
        <input
          id="arrival-datetime"
          name="arrivalDateTime"
          type="date"
          required
        />
      </label>

      <label>
        Departure port
        <select id="exit-port" name="exitPort" required>
          <option value="">Select a departure port</option>
          {
            sortedPorts.map((port) => (
              <option value={port.portName}>
                {port.portName} — {port.region}
              </option>
            ))
          }
          <option value="__other__">Another port / not listed</option>
        </select>
      </label>

      <label>
        Departure date
        <input
          id="departure-datetime"
          name="departureDateTime"
          type="date"
          required
        />
      </label>

      <p class="helper-text">
        Enter local China arrival and departure times.
      </p>

      <div class="step-actions">
        <button type="button" class="secondary-button" data-previous-step>
          Back
        </button>
        <button type="button" class="primary-button" data-next-step>
          Continue
        </button>
      </div>
    </section>

    <section class="checker-step" data-step="4" hidden>
      <p class="step-label">Step 4 of 4</p>
      <h3>Travel area and onward documents</h3>

      <fieldset>
        <legend>
          Will all of your travel in Mainland China stay within the currently
          permitted areas?
        </legend>

        <details class="area-details">
          <summary>View the 24 participating regions and permitted areas</summary>
          <div class="area-list">
            {
              sortedPermittedAreas.map((area) => (
                <div class="area-item">
                  <strong>{area.region}</strong>
                  <span>{area.permittedStayArea}</span>
                </div>
              ))
            }
          </div>
        </details>

        <label class="radio-option">
          <input
            type="radio"
            name="staysWithinPermittedAreas"
            value="yes"
            required
          />
          Yes
        </label>

        <label class="radio-option">
          <input
            type="radio"
            name="staysWithinPermittedAreas"
            value="no"
          />
          No
        </label>

        <label class="radio-option">
          <input
            type="radio"
            name="staysWithinPermittedAreas"
            value="unsure"
          />
          I'm not sure
        </label>
      </fieldset>
<fieldset>
        <legend>
          Are you legally able to enter your onward country or region?
        </legend>

        <p class="helper-text">
          For example, if that destination requires a visa, ETA, or other
          travel authorization for your nationality, you should already meet
          that requirement. This is separate from the China transit-route test.
        </p>

        <label class="radio-option">
          <input
            type="radio"
            name="canEnterOnwardDestination"
            value="yes"
            required
          />
          Yes
        </label>

        <label class="radio-option">
          <input type="radio" name="canEnterOnwardDestination" value="no" />
          No
        </label>

        <label class="radio-option">
          <input
            type="radio"
            name="canEnterOnwardDestination"
            value="unsure"
          />
          I'm not sure
        </label>
      </fieldset>

      <fieldset>
        <legend>
          Do you have circumstances that may require individual immigration
          review, such as a recent Chinese visa refusal or prior Chinese
          immigration violation?
        </legend>

        <label class="radio-option">
          <input
            type="radio"
            name="specialReviewCircumstances"
            value="no"
            required
          />
          No
        </label>

        <label class="radio-option">
          <input
            type="radio"
            name="specialReviewCircumstances"
            value="yes"
          />
          Yes
        </label>

        <label class="radio-option">
          <input
            type="radio"
            name="specialReviewCircumstances"
            value="unsure"
          />
          I'm not sure
        </label>
      </fieldset>

      <div class="step-actions">
        <button type="button" class="secondary-button" data-previous-step>
          Back
        </button>
        <button type="submit" class="primary-button">
          Check my itinerary
        </button>
      </div>
    </section>
  </form>

  <section id="checker-result" class="checker-result" hidden aria-live="polite">
    <div id="result-heading"></div>
    <div id="result-summary"></div>
    <div id="result-rules"></div>

    <div class="result-actions">
      <button type="button" class="secondary-button" id="edit-itinerary">
        Edit itinerary
      </button>
      <button type="button" class="secondary-button" id="start-over">
        Start over
      </button>
    </div>

    <p class="checker-disclaimer">
      This checker is informational. It does not guarantee airline boarding or
      admission into China. Immigration authorities make the final decision.
    </p>
  </section>
</section>

<script>
  import {
    evaluateTransitEligibility,
    type TransitAnswer,
  } from '../lib/transit-eligibility';

  const form = document.querySelector<HTMLFormElement>('#transit-checker-form');
  const resultContainer =
    document.querySelector<HTMLElement>('#checker-result');

  if (form && resultContainer) {
    let currentStep = 1;

    const steps = Array.from(
      form.querySelectorAll<HTMLElement>('[data-step]')
    );

    const progressSteps = Array.from(
      form.querySelectorAll<HTMLElement>('[data-progress-step]')
    );

    const routePlaceValues = new Set<string>();

    form.querySelectorAll('#route-places option').forEach((option: any) => {
      routePlaceValues.add(String(option.value).trim());
    });

    const routePlaceInputs = [
      form.querySelector('#previous-country') as any,
      form.querySelector('#next-country') as any,
    ].filter(Boolean);

    const validateRoutePlace = (input: any) => {
      const value = String(input.value ?? '').trim();

      if (!value) {
        input.setCustomValidity('');
        return;
      }

      if (routePlaceValues.has(value)) {
        input.setCustomValidity('');
      } else {
        input.setCustomValidity(
          'Please select a country or region from the list, or choose “Other / not listed.”'
        );
      }
    };

    for (const input of routePlaceInputs) {
      input.addEventListener('input', () => validateRoutePlace(input));
      input.addEventListener('change', () => validateRoutePlace(input));
      input.addEventListener('blur', () => validateRoutePlace(input));
    }

    const previousRouteInput =
      form.querySelector('#previous-country') as any;

    const nextRouteInput =
      form.querySelector('#next-country') as any;

    const previousOtherWrap =
      form.querySelector('#previous-country-other-wrap') as any;

    const nextOtherWrap =
      form.querySelector('#next-country-other-wrap') as any;

    const previousOtherInput =
      form.querySelector('#previous-country-other') as any;

    const nextOtherInput =
      form.querySelector('#next-country-other') as any;

    const validateManualRouteInput = (input: any) => {
      if (!input || !input.required) {
        input?.setCustomValidity('');
        return true;
      }

      const value = String(input.value ?? '').trim();

      if (!value) {
        input.setCustomValidity(
          'Please enter the actual country or region name.'
        );
        return false;
      }

      if (value.length < 2) {
        input.setCustomValidity(
          'Please enter at least 2 characters.'
        );
        return false;
      }

      if (value.length > 80) {
        input.setCustomValidity(
          'Please keep the country or region name under 80 characters.'
        );
        return false;
      }

      if (!/\p{L}/u.test(value)) {
        input.setCustomValidity(
          'Please enter a country or region name containing letters.'
        );
        return false;
      }

      input.setCustomValidity('');
      return true;
    };

    const syncOtherRouteField = (
      routeInput: any,
      wrapper: any,
      manualInput: any
    ) => {
      if (!routeInput || !wrapper || !manualInput) return;

      const isOther =
        String(routeInput.value ?? '').trim() === 'Other / not listed';

      wrapper.hidden = !isOther;
      manualInput.required = isOther;

      if (!isOther) {
        manualInput.value = '';
        manualInput.setCustomValidity('');
      } else {
        validateManualRouteInput(manualInput);
      }
    };

    const syncOtherRouteFields = () => {
      syncOtherRouteField(
        previousRouteInput,
        previousOtherWrap,
        previousOtherInput
      );

      syncOtherRouteField(
        nextRouteInput,
        nextOtherWrap,
        nextOtherInput
      );
    };

    previousRouteInput?.addEventListener(
      'input',
      syncOtherRouteFields
    );

    previousRouteInput?.addEventListener(
      'change',
      syncOtherRouteFields
    );

    nextRouteInput?.addEventListener(
      'input',
      syncOtherRouteFields
    );

    nextRouteInput?.addEventListener(
      'change',
      syncOtherRouteFields
    );

    previousOtherInput?.addEventListener('input', () => {
      validateManualRouteInput(previousOtherInput);
    });

    previousOtherInput?.addEventListener('blur', () => {
      validateManualRouteInput(previousOtherInput);
    });

    nextOtherInput?.addEventListener('input', () => {
      validateManualRouteInput(nextOtherInput);
    });

    nextOtherInput?.addEventListener('blur', () => {
      validateManualRouteInput(nextOtherInput);
    });

    syncOtherRouteFields();

    const showStep = (stepNumber: number) => {
      currentStep = stepNumber;

      for (const step of steps) {
        step.hidden = Number(step.dataset.step) !== stepNumber;
      }

      for (const progressStep of progressSteps) {
        const number = Number(progressStep.dataset.progressStep);

        progressStep.classList.toggle('is-active', number === stepNumber);
        progressStep.classList.toggle('is-complete', number < stepNumber);
      }
    };

    const validateCurrentStep = () => {
      const step = steps.find(
        (item) => Number(item.dataset.step) === currentStep
      );

      if (!step) return false;

      if (currentStep === 2) {
        for (const input of routePlaceInputs) {
          validateRoutePlace(input);

          if (!input.checkValidity()) {
            input.reportValidity();
            return false;
          }
        }

        for (const input of [
          previousOtherInput,
          nextOtherInput,
        ]) {
          if (input?.required) {
            validateManualRouteInput(input);

            if (!input.checkValidity()) {
              input.reportValidity();
              return false;
            }
          }
        }
      }

      const requiredFields = Array.from(
        step.querySelectorAll('[required]')
      ) as any[];

      for (const field of requiredFields) {
        if (!field.checkValidity()) {
          field.reportValidity();
          return false;
        }
      }

      return true;
    };

    form.querySelectorAll('[data-next-step]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!validateCurrentStep()) return;

        showStep(Math.min(4, currentStep + 1));
      });
    });

    form.querySelectorAll('[data-previous-step]').forEach((button) => {
      button.addEventListener('click', () => {
        showStep(Math.max(1, currentStep - 1));
      });
    });

    const nationality = form.querySelector('#nationality') as any;

    const usPassportNote =
      form.querySelector<HTMLElement>('#us-passport-note');

    const pickerOnlyDateTimes = [
      form.querySelector('#arrival-datetime') as any,
      form.querySelector('#departure-datetime') as any,
    ].filter(Boolean);

    const openDateTimePicker = (input: any) => {
      try {
        input.showPicker?.();
      } catch {
        // The browser will fall back to its normal date/time control.
      }
    };

    for (const input of pickerOnlyDateTimes) {
      input.addEventListener('click', () => {
        openDateTimePicker(input);
      });

      input.addEventListener('keydown', (event: any) => {
        if (
          event.key === 'Tab' ||
          event.key === 'Shift' ||
          event.key === 'Escape'
        ) {
          return;
        }

        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openDateTimePicker(input);
          return;
        }

        event.preventDefault();
      });

      input.addEventListener('paste', (event: any) => {
        event.preventDefault();
      });

      input.addEventListener('drop', (event: any) => {
        event.preventDefault();
      });
    }

    nationality?.addEventListener('change', () => {
      if (usPassportNote) {
        usPassportNote.hidden = nationality.value !== 'United States';
      }
    });

const getAnonymousSessionId = () => {
  const key = 'jadebound_checker_session_id';

  let value = sessionStorage.getItem(key);

  if (!value) {
    value = crypto.randomUUID();
    sessionStorage.setItem(key, value);
  }

  return value;
};

const getNextSearchSequence = () => {
  const key = 'jadebound_checker_search_sequence';

  const current = Number(sessionStorage.getItem(key) ?? '0');
  const next = current + 1;

  sessionStorage.setItem(key, String(next));

  return next;
};

const getDeviceType = () => {
  const navigatorWithUserAgentData = navigator as Navigator & {
    userAgentData?: {
      mobile?: boolean;
    };
  };

  if (navigatorWithUserAgentData.userAgentData?.mobile === true) {
    return 'mobile';
  }

  const userAgent = navigator.userAgent;

  if (
    /iPad|Tablet|PlayBook|Silk/i.test(userAgent) ||
    (/Android/i.test(userAgent) && !/Mobile/i.test(userAgent))
  ) {
    return 'tablet';
  }

  if (
    /Mobi|Android|iPhone|iPod|IEMobile|Opera Mini/i.test(userAgent)
  ) {
    return 'mobile';
  }

  return 'desktop';
};
const getUtmParameter = (name: string) => {
  const params = new URLSearchParams(window.location.search);
  return params.get(name) ?? undefined;
};

const logCheckerSearch = async (payload: Record<string, unknown>) => {
  try {
    await fetch('/api/checker-log', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(payload),
      keepalive: true,
    });
  } catch (error) {
    console.warn('Checker analytics logging failed', error);
  }
};

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);

      const selectedNationality = String(data.get('nationality') ?? '');

      const selectedEntryPort = String(data.get('entryPort') ?? '');
      const selectedExitPort = String(data.get('exitPort') ?? '');

      const previousRouteSelection = String(
        data.get('previousCountryOrRegion') ?? ''
      ).trim();

      const nextRouteSelection = String(
        data.get('nextCountryOrRegion') ?? ''
      ).trim();

      const previousRouteIsUnlisted =
        previousRouteSelection === 'Other / not listed';

      const nextRouteIsUnlisted =
        nextRouteSelection === 'Other / not listed';

      const previousRouteValue = previousRouteIsUnlisted
        ? String(
            data.get('previousCountryOrRegionOther') ?? ''
          ).trim()
        : previousRouteSelection;

      const nextRouteValue = nextRouteIsUnlisted
        ? String(
            data.get('nextCountryOrRegionOther') ?? ''
          ).trim()
        : nextRouteSelection;

      const result = evaluateTransitEligibility({
        nationality:
          selectedNationality === '__other__'
            ? 'Other nationality'
            : selectedNationality,

        passportExpirationDate: String(
          data.get('passportExpirationDate') ?? ''
        ),

        previousCountryOrRegion: previousRouteValue,
        nextCountryOrRegion: nextRouteValue,

        previousCountryOrRegionIsUnlisted:
          previousRouteIsUnlisted,

        nextCountryOrRegionIsUnlisted:
          nextRouteIsUnlisted,

        entryPort: selectedEntryPort,

        exitPort:
          selectedExitPort === '__other__'
            ? 'Other / unlisted port'
            : selectedExitPort,

        arrivalDateTime: String(data.get('arrivalDateTime') ?? ''),

        departureDateTime: String(data.get('departureDateTime') ?? ''),

        staysWithinPermittedAreas: String(
          data.get('staysWithinPermittedAreas') ?? 'unsure'
        ) as TransitAnswer,
canEnterOnwardDestination: String(
          data.get('canEnterOnwardDestination') ?? 'unsure'
        ) as TransitAnswer,

        specialReviewCircumstances: String(
          data.get('specialReviewCircumstances') ?? 'unsure'
        ) as TransitAnswer,
      });

const anonymousSessionId = getAnonymousSessionId();
const searchSequence = getNextSearchSequence();

void logCheckerSearch({
  anonymousSessionId,
  searchSequence,

  passportCountry:
    selectedNationality === '__other__'
      ? 'Other nationality'
      : selectedNationality,

  passportExpirationDate: String(
    data.get('passportExpirationDate') ?? ''
  ),

  previousCountryOrRegion: previousRouteValue,
  previousCountryOrRegionIsUnlisted: previousRouteIsUnlisted,

  nextCountryOrRegion: nextRouteValue,
  nextCountryOrRegionIsUnlisted: nextRouteIsUnlisted,

  entryPort: selectedEntryPort,

  exitPort:
    selectedExitPort === '__other__'
      ? 'Other / unlisted port'
      : selectedExitPort,

  arrivalDate: String(data.get('arrivalDateTime') ?? ''),
  departureDate: String(data.get('departureDateTime') ?? ''),

  staysWithinPermittedAreas: String(
    data.get('staysWithinPermittedAreas') ?? 'unsure'
  ),

  canEnterOnwardDestination: String(
    data.get('canEnterOnwardDestination') ?? 'unsure'
  ),

  specialReviewCircumstances: String(
    data.get('specialReviewCircumstances') ?? 'unsure'
  ),

  overallStatus: result.status,

  rules: result.rules.map((rule) => ({
    id: rule.id,
    status: rule.status,
  })),

  checkerVersion: '1.0',
  rulesVersion: '2026-09-22',

  entryPage: window.location.pathname,
  referrer: document.referrer || undefined,

  utmSource: getUtmParameter('utm_source'),
  utmMedium: getUtmParameter('utm_medium'),
  utmCampaign: getUtmParameter('utm_campaign'),

  deviceType: getDeviceType(),
});

      const heading = document.querySelector<HTMLElement>('#result-heading');
      const summary = document.querySelector<HTMLElement>('#result-summary');
      const rules = document.querySelector<HTMLElement>('#result-rules');

      if (!heading || !summary || !rules) return;

      resultContainer.classList.remove(
        'result-pass',
        'result-fail',
        'result-review'
      );

      resultContainer.classList.add(`result-${result.status}`);

      if (result.status === 'pass') {
        heading.innerHTML =
          '<h3>Your itinerary appears to pass the core checks</h3>';

        summary.innerHTML =
          '<p>Your answers appear to meet the core published requirements checked by this tool.</p>';
      } else if (result.status === 'fail') {
        heading.innerHTML =
          '<h3>Your itinerary does not appear to meet the 240-hour requirements</h3>';

        summary.innerHTML =
          '<p>One or more core checks did not pass. Review the details below.</p>';
      } else {
        heading.innerHTML =
          '<h3>Your itinerary needs additional verification</h3>';

        summary.innerHTML =
          '<p>We cannot confirm this itinerary from the information provided. Review the items marked below before relying on the policy.</p>';
      }

      summary.insertAdjacentHTML(
        'beforeend',
        '<p><strong>Confirmed onward travel required:</strong> This checker does not verify your ticket or booking. To use the 240-hour visa-free transit policy, you must have confirmed onward transportation from Mainland China to the country or region you entered above, with a confirmed departure date and seat or booking.</p>'
      );

      if (result.deadlineChinaDateTimeDisplay) {
        summary.insertAdjacentHTML(
          'beforeend',
          `<p><strong>Your calculated departure deadline:</strong> ${result.deadlineChinaDateTimeDisplay} China time</p>`
        );
      }

      rules.innerHTML = '';

      for (const rule of result.rules) {
        const item = document.createElement('div') as any;

        item.className = `rule-result rule-${rule.status}`;

        const symbol =
          rule.status === 'pass'
            ? '✓'
            : rule.status === 'fail'
              ? '✕'
              : '!';

        const title = document.createElement('div') as any;
        title.className = 'rule-title';

        const symbolElement = document.createElement('span') as any;
        symbolElement.className = 'rule-symbol';
        symbolElement.textContent = symbol;

        const label = document.createElement('strong') as any;
        label.textContent = rule.label;

        title.append(symbolElement, label);

        const message = document.createElement('p') as any;
        message.textContent = rule.message;

        item.append(title, message);
        rules.appendChild(item);
      }

      form.hidden = true;
      resultContainer.hidden = false;

      resultContainer.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    });

    document
      .querySelector<HTMLButtonElement>('#edit-itinerary')
      ?.addEventListener('click', () => {
        resultContainer.hidden = true;
        form.hidden = false;
        showStep(1);

        form.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      });

    document
      .querySelector<HTMLButtonElement>('#start-over')
      ?.addEventListener('click', () => {
        form.reset();

        if (usPassportNote) {
          usPassportNote.hidden = true;
        }

        syncOtherRouteFields();

        resultContainer.hidden = true;
        form.hidden = false;
        showStep(1);

        form.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      });
  }
</script>

