{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "china-transit-guide",
        "workers_dev": false,
        "routes": [
                {
                        "pattern": "jadebound.com",
                        "custom_domain": true
                }
        ],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}