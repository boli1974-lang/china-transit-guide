{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "china-transit-guide",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "jadebound.com",
			"custom_domain": true
		}
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "CHECKER_DB",
			"database_name": "jadebound-checker-data",
			"database_id": "9a472ecf-a6d3-4bec-9c60-a6b623ca6dab"
		}
	]
}